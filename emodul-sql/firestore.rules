rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /materi/{materiId} {
      allow read, write: if request.auth != null;
    }

    match /video/{videoId} {
      allow read, write: if request.auth != null;
    }

    match /latihan/{latihanId} {
      allow read, write: if request.auth != null;
    }

    match /latihan_sql/{docId} {
      allow read, write: if request.auth != null;
    }

    match /kuis/{kuisId} {
      allow read, write: if request.auth != null;
    }

    match /hasilKuis/{docId} {
      allow read, write: if request.auth != null;
    }

    match /progres/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
